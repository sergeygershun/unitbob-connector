#!/bin/sh
# Blocks one thing: sending `main` a revision whose version npm cannot fetch.
# The plugin ships from this repository, so `main`'s `npx -y unitbob@<v>` lines
# are what hosts execute; naming a version npm does not have makes every command
# fail at fetch. Enforces the order spec 33's DoD already asks for — npm first,
# then main.
#
# Only `main`, and this matters more than it looks. A first version of this hook
# ran on every push, which put "publish to npm" in front of pushing a working
# branch — the ordinary way to get a change looked at before it goes near
# production. The single way out is an environment variable, so a guard that
# fires where it has no business teaches people to type that variable by habit,
# and then it is gone from `main` too. A guard that is routinely bypassed is
# worse than none: it still reads like protection.
#
# Git feeds pre-push one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# The version is read from `<local sha>`, not from the working tree, because the
# working tree is not what is being sent. Checking the wrong artifact is the
# very mistake this guards against.
#
# Note: `npm run hooks:install` sets `core.hooksPath`, which takes the whole
# hook directory over from `.git/hooks` — anything you kept there stops running.
ZERO=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  # A deletion has nothing to check.
  [ "$local_sha" = "$ZERO" ] && continue

  npm run --silent check:release -- --revision "$local_sha" || status=1
done

exit $status
